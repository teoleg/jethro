# Jethro local run config — copy to `local.env` and edit. Sourced by scripts/run-local.sh
# (and therefore scripts/svc.sh). `local.env` is gitignored, so your settings stay local.
#
# Precedence: command-line env  >  local.env  >  script defaults.
# The `:=` form assigns only when unset, so `PROVIDER=yahoo ./scripts/svc.sh restart app`
# still overrides whatever you put here.

: "${PROVIDER:=sim}"        # sim | yahoo (delayed) | finnhub (real-time WS — needs FINNHUB)
: "${AI:=on}"              # on = Ollama commentary + hypotheses; off = market path + UI only
: "${RAG:=on}"            # on = retrieval (ADR-0035); needs the embedding model (auto-pulled)
: "${AUTOEXEC:=on}"       # on = momentum strategy auto-submits SIMULATED orders (ADR-0019)
: "${AUTONOMY:=on}"       # on = LLM hypotheses auto-execute inside the risk envelope (ADR-0022)
: "${MODEL:=qwen2.5:1.5b}" # chat model — :0.5b for very tight RAM, :3b for 8GB+ boxes
: "${EMBED_MODEL:=nomic-embed-text}" # RAG embedding model (separate download from MODEL)
: "${HEAP:=512m}"         # JVM max heap
: "${PROFILE:=pi}"        # Spring profile: pi | default
# : "${FINNHUB:=your_token_here}"   # required only for PROVIDER=finnhub; also enables live news/curve

export PROVIDER AI RAG AUTOEXEC AUTONOMY MODEL EMBED_MODEL HEAP PROFILE FINNHUB
