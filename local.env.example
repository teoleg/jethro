# Jethro local run config — plain KEY=value. Copy to `local.env` and edit; it's gitignored.
# Command-line env overrides these:  PROVIDER=yahoo ./scripts/svc.sh restart app

PROVIDER=sim
AI=on
RAG=on
AUTOEXEC=on
AUTONOMY=on
MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text
HEAP=512m
PROFILE=pi
#SIM_DAY_SECONDS=23400   # wall-secs per sim trading day: 23400 = real time (default), 120 = day in 2 min
#FINNHUB=your_token_here
# Real daily history seed (ADR-0038): grounds the hedger covariance in real cross-asset returns from
# tick one, even in sim. Source = Tiingo (free key at tiingo.com). Blank/unset → seed is skipped and
# covariance warms from the live feed (harmless). Read by jethro.hedge.tiingo-token=${TIINGO_API_TOKEN:}.
#TIINGO_API_TOKEN=your_token_here

# ─────────────────────── muni-world (independent service, :8090) ───────────────────────
# svc.sh reads these too (start/stop/restart muni, tv). NOTE: no inline comments on value lines.
# Include muni-world in `svc.sh start all`? (false = start it yourself with `svc.sh start muni`)
MUNI_AUTOSTART=false
MUNI_PORT=8090
# Postgres — the SAME jethro database, muni's OWN `muni` schema inside it (no extra container, no
# extra database, no provisioning; every muni table is muni.*). Set MUNI_FLYWAY_ENABLED=true to
# persist loaded bonds to the DB (muni.security); false = LMDB-only, jar still boots offline.
MUNI_DB_URL=jdbc:postgresql://localhost:5432/jethro
MUNI_DB_USER=jethro
MUNI_DB_PASSWORD=jethro
MUNI_FLYWAY_ENABLED=false
# LMDB derived store + Kafka (off until wired)
MUNI_LMDB_PATH=build/muni-lmdb
MUNI_LMDB_MAP_MB=64
MUNI_KAFKA_ENABLED=false
MUNI_KAFKA_BOOTSTRAP=localhost:19092

# ─────────────────────── TV audio capture (ADR-0014) ───────────────────────
# `svc.sh tv setup` installs whisper.cpp/ffmpeg and WRITES MUNI_WHISPER_BIN/MODEL below for you.
# Master switch (svc.sh tv start/stop toggles it):
MUNI_AUDIO_CAPTURE=false
# whisper.cpp — written by `svc.sh tv setup`:
MUNI_WHISPER_BIN=whisper-cli
MUNI_WHISPER_MODEL=
MUNI_FFMPEG_BIN=ffmpeg
MUNI_AUDIO_GAP_MS=1000
# Absolute path to yt-dlp (it resolves the live stream URL each capture). Written by `svc.sh setup tv`.
# Absolute, because muni-world runs in the background and its PATH may not include ~/.local/bin.
#MUNI_YTDLP_BIN=/home/kapara/.local/bin/yt-dlp
# Absolute path to a JavaScript runtime (Deno). Current yt-dlp needs one to see YouTube's audio-only
# formats; without it capture falls back to the video+audio rendition and drops the video (more bandwidth,
# still works). Written by `svc.sh setup tv`.
#MUNI_JS_RUNTIME=/home/kapara/.deno/bin/deno

# ─────────────────────── polite crawl + EMMA discovery (ADR-0008 / ADR-0015) ───────────────────────
# Sensible defaults; uncomment to tune on the Pi. (Set MUNI_OCR_ENABLED=true with tesseract for scanned PDFs.)
#MUNI_CRAWL_INTERVAL_MS=2000
#MUNI_OCR_ENABLED=false
