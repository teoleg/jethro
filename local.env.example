# Jethro local run config — plain KEY=value. Copy to `local.env` and edit; it's gitignored.
# Command-line env overrides these:  PROVIDER=yahoo ./scripts/svc.sh restart app

PROVIDER=sim
AI=on
RAG=on
AUTOEXEC=on
AUTONOMY=on
MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text
HEAP=512m
PROFILE=pi
#SIM_DAY_SECONDS=23400   # wall-secs per sim trading day: 23400 = real time (default), 120 = day in 2 min
#FINNHUB=your_token_here
