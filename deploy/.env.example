# Template for deploy/.env — the real file is GENERATED on the node by remote-deploy.sh from
# SSM Parameter Store ($JETHRO_SSM_PREFIX, default /jethro/prod) and is NEVER committed.
# Shown here so the required settings are documented in one place. Create the SSM params
# once (see deploy/README.md); the deploy workflow injects them at rollout.

# App image — set by the deploy workflow to the ECR ref for the built commit. Not an SSM param.
APP_IMAGE=123456789012.dkr.ecr.eu-west-1.amazonaws.com/jethro-app:<git-sha>

# Postgres credentials (SSM: /jethro/prod/POSTGRES_USER, /POSTGRES_PASSWORD as SecureString)
POSTGRES_USER=jethro
POSTGRES_PASSWORD=change-me-strong

# Market-data provider + AI model (SSM: /jethro/prod/JETHRO_TRADING_PROVIDER, /JETHRO_AI_MODEL)
JETHRO_TRADING_PROVIDER=sim          # sim | yahoo | finnhub
JETHRO_AI_MODEL=qwen2.5:1.5b         # CPU-friendly SLM; bump to qwen2.5:3b if the box has room
FINNHUB_TOKEN=                        # only needed when provider=finnhub (SSM SecureString)
TIINGO_API_TOKEN=                     # real daily history seed for the hedger covariance (ADR-0038); free key at tiingo.com; blank = skip (SSM SecureString)

# Public edge — Caddy TLS + basic auth (SSM: /jethro/prod/JETHRO_DOMAIN, /JETHRO_BASIC_AUTH_USER,
# /JETHRO_BASIC_AUTH_HASH). DOMAIN must resolve to the node's Elastic IP (a real domain, or a
# <ip-with-dashes>.nip.io). HASH from: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'yourpw'
JETHRO_DOMAIN=jethro.example.com
JETHRO_BASIC_AUTH_USER=oleg
JETHRO_BASIC_AUTH_HASH=$2a$14$replace-with-a-real-bcrypt-hash
