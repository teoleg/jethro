{
  "type": "record",
  "name": "OrderCommand",
  "namespace": "io.jethro.messaging",
  "doc": "New-order command on orders.new. idempotencyKey implements invariant 6 on the order path: redelivery must not create a second order.",
  "fields": [
    {"name": "meta", "type": "io.jethro.messaging.EventMeta"},
    {"name": "orderId", "type": "string"},
    {"name": "idempotencyKey", "type": "string"},
    {"name": "bookId", "type": "string"},
    {"name": "instrumentId", "type": "string"},
    {"name": "side", "type": "io.jethro.messaging.Side"},
    {"name": "orderType", "type": {"type": "enum", "name": "OrderType", "namespace": "io.jethro.messaging", "symbols": ["MARKET", "LIMIT"]}},
    {"name": "quantity", "type": {"type": "bytes", "logicalType": "decimal", "precision": 20, "scale": 6}},
    {"name": "limitPrice", "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 20, "scale": 6}], "default": null}
  ]
}
