# jethro.env — the SINGLE place to configure the local stack (core jethro + muni-world + TV audio).
#
# Copy to scripts/jethro.env and edit for this host. scripts/svc.sh sources it automatically (exporting
# every value), so `svc.sh start|stop|restart <target>` picks these up. scripts/jethro.env is gitignored
# (host-specific paths/devices); this .example is the committed template. `svc.sh tv setup` fills in the
# audio values for you.
#
# These are host/tool config and feature toggles — NOT money/risk dials. muni-world's risk parameters (when
# it gets any) carry provenance in application.properties the same way jethro's do.

# ─────────────────────────── core jethro ───────────────────────────
# The app + infra (Postgres/Ollama/Redpanda) are managed by run-local.sh / docker compose; svc.sh drives
# them. Include core toggles here if/when you want them overridable from one place.
# JETHRO_PORT=8080

# Include muni-world (and, if its capture flag is on, TV) in `svc.sh start all` / `restart all`.
# Default false → muni stays opt-in (`svc.sh start muni`), preserving the original behavior.
MUNI_AUTOSTART=false

# ─────────────────────────── muni-world service ───────────────────────────
MUNI_PORT=8090
# Postgres — the SHARED instance, muni-world's OWN database. Creds are placeholders; set real ones here.
MUNI_DB_URL=jdbc:postgresql://localhost:5432/muni_world
MUNI_DB_USER=muni
MUNI_DB_PASSWORD=muni
MUNI_FLYWAY_ENABLED=false          # turn on once Postgres is up and you want muni's schema migrated
# LMDB — embedded, derived-only search index (ADR-0013); its own path under the repo (gitignored).
MUNI_LMDB_PATH=build/muni-lmdb
MUNI_LMDB_MAP_MB=64
# Kafka / Redpanda — shared broker; muni owns its muni.* topics. Off until wired.
MUNI_KAFKA_ENABLED=false
MUNI_KAFKA_BOOTSTRAP=localhost:19092

# ─────────────────────────── TV audio capture (ADR-0014) ───────────────────────────
# Capture the audio of LICENSED broadcast feeds (your YouTube TV: Bloomberg/CNBC), transcribe locally,
# surface leads. A transcript is a lead to VERIFY, never a number. `svc.sh tv setup` installs
# whisper.cpp/ffmpeg; `svc.sh tv start|stop` flips the master switch below and restarts muni.
MUNI_AUDIO_CAPTURE=false           # MASTER switch; svc.sh tv start/stop toggles this
MUNI_WHISPER_BIN=whisper-cli       # path printed by `svc.sh tv setup`
MUNI_WHISPER_MODEL=                # REQUIRED to transcribe — e.g. ~/whisper.cpp/models/ggml-base.en.bin
MUNI_WHISPER_TIMEOUT=600
MUNI_FFMPEG_BIN=ffmpeg
MUNI_AUDIO_GAP_MS=1000             # pause between capture passes
# The FEEDS are a REGISTRY, not vars here (they grow, like the market-data/social sources). Point this at
# your editable feed list — id,label,publisher,category,device,chunk_seconds,enabled,notes — bind each feed
# to a host device (pulse:default.monitor / alsa:hw:1,0) and enable it there. Served at
# /api/muni/audio/sources and shown in the muni UI. Blank → the committed default (feeds listed, none bound).
MUNI_AUDIO_SOURCES_FILE=muni-world/seeds/audio-sources.csv
